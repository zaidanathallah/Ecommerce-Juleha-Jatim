APP_NAME="Juleha Marketplace Jatim"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE="Asia/Jakarta"
APP_URL=http://localhost:8000

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Primary Database (E-commerce Marketplace)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=juleha_marketplace
DB_USERNAME=root
DB_PASSWORD=

# Secondary Database (Juleha Central Members - Read-Only Bridge)
DB_MEMBERS_HOST=127.0.0.1
DB_MEMBERS_PORT=3306
DB_MEMBERS_DATABASE=julehaaja_members
DB_MEMBERS_USERNAME=root
DB_MEMBERS_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=juleha_

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="no-reply@jualbeli.julehajatim.com"
MAIL_FROM_NAME="${APP_NAME}"

# DOKU SNAP Payment Gateway
DOKU_BASE_URL=https://api-sandbox.doku.com
DOKU_CLIENT_ID=your_doku_client_id
DOKU_SECRET_KEY=your_doku_secret_key
DOKU_API_KEY=your_doku_api_key
DOKU_MERCHANT_PUBLIC_KEY="your_doku_merchant_public_key"
DOKU_PUBLIC_KEY="your_doku_public_key"

# Biteship Logistics Gateway
BITESHIP_BASE_URL=https://api.biteship.com
BITESHIP_API_KEY=your_biteship_api_key
BITESHIP_KEY_ID=your_biteship_key_id

VITE_APP_NAME="${APP_NAME}"
